# Environment Variables for POS Tax VAT System
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# Database Configuration
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration
# Must be at least 256 bits (32 bytes) for HS256
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_long

# Encryption Configuration
# Must be exactly 32 bytes for AES-256-GCM
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Hash Configuration
# Must be at least 32 bytes for HMAC-SHA256
HASH_KEY=your_32_byte_hash_key_here
